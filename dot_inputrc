#Ctrl+X then O copies the current (copybuffer plugin)
"\C-o": "luafunc:copy_current_buffer"

# Clear current typing and clear screen in Clink
Control-l: "\C-e\C-ucls\C-m"

# Clink-fzf tab completion
"\t": "luafunc:fzf_complete_force"
"\C-t": "luafunc:fzf_file"
"\C-r": "luafunc:fzf_history"
"\M-c": "luafunc:fzf_directory"
"\M-b": "luafunc:fzf_bindings"
"\e[27;5;32~": "luafunc:fzf_complete_force"

set echo-control-characters off
