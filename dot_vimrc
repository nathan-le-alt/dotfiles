" Set leader key
let mapleader = " "

" Settings ---
set shortmess-=l
set noshowmode        " hide mode text
set encoding=UTF-8
syntax on        
set number        
" set relativenumber  
set mouse=
set cursorline      
set showcmd          
" set spell spelllang=en_us
set signcolumn=auto
set termguicolors

" Indentation 
set tabstop=2        
set softtabstop=2    
set shiftwidth=2    
" set noexpandtab  
set expandtab         " convert tabs to spaces
filetype plugin indent on
autocmd FileType python setlocal tabstop=4 softtabstop=4 shiftwidth=4
autocmd FileType make,go setlocal noexpandtab
set breakindent
set linebreak
set showbreak=>\ 

" Search and navigation
set hlsearch      
set incsearch   
set ignorecase   
set smartcase  
set scrolloff=8

" Performance and behavior
