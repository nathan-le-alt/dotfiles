vnoremap <silent><nowait><expr> <c-f> coc#float#has_scroll() ? coc#float#scroll(1) : "\<c-f>"
vnoremap <silent><nowait><expr> <c-b> coc#float#has_scroll() ? coc#float#scroll(0) : "\<c-b>"

nnoremap <silent><nowait><expr> <c-d> coc#float#has_scroll() ? coc#float#scroll(1, 1) : "\<c-d>"
nnoremap <silent><nowait><expr> <c-u> coc#float#has_scroll() ? coc#float#scroll(0, 1) : "\<c-u>"
inoremap <silent><nowait><expr> <c-d> coc#float#has_scroll() ? "\<c-r>=coc#float#scroll(1, 1)\<cr>" : "\<c-d>"
inoremap <silent><nowait><expr> <c-u> coc#float#has_scroll() ? "\<c-r>=coc#float#scroll(0, 1)\<cr>" : "\<c-u>"
vnoremap <silent><nowait><expr> <c-d> coc#float#has_scroll() ? coc#float#scroll(1, 1) : "\<c-d>"
vnoremap <silent><nowait><expr> <c-u> coc#float#has_scroll() ? coc#float#scroll(0, 1) : "\<c-u>"

" Close a buffer
nnoremap <leader>w :bd<cr>

" Splitting buffers
nnoremap sh :split<cr>
nnoremap sv :vsplit<cr>
nnoremap sc :close<cr>
nnoremap so :only<cr>

" Remap delete to black hole register (delete without yanking)
nnoremap d "_d
nnoremap c "_c
nnoremap x "_x
vnoremap d "_d
vnoremap c "_c
vnoremap x "_x

" Cutting (yank to default register)
nnoremap <leader>d d
vnoremap <leader>d d
nnoremap <leader>dd dd

" Pasting (paste over selection without overwriting register)
vnoremap p "_dp
" End Keybindings +++


" CodeRunner ---
function! Runcode() abort
  if &buftype ==# 'terminal'
    echo 'Switch to the source file first!'
    return
  endif
  write
  let l:filetype = &filetype
  let l:curr_win = win_getid()
  let l:file = expand('%:p')
  let l:output = expand('%:p:r')

  if l:filetype ==# 'python'
    let l:cmd = ['python3', l:file]
  elseif l:filetype ==# 'c'
    if has('win32') || has('win64')
      let l:vcvars = '"C:\Program Files (x86)\Microsoft Visual Studio\18\BuildTools\VC\Auxiliary\Build\vcvars64.bat"'
      let l:cmd = 'cmd.exe /c "' . l:vcvars . ' >nul && clang "' . l:file . '" -o "' . l:output . '.exe" -Wall -Wextra && "' . l:output . '.exe"'
    else
      let l:cmd = ['bash', '-c', 'clang "$1" -o "$2" -Wall -Wextra && "$2"', 'bash', l:file, l:output]
    endif
  elseif l:filetype ==# 'javascript'
    let l:cmd = ['node', l:file]
  else
    echo 'No run command set for filetype: ' . l:filetype
    return
  endif

  for l:bufnr in range(1, bufnr('$'))
    if bufexists(l:bufnr) && getbufvar(l:bufnr, '&buftype') ==# 'terminal'
      execute 'bwipeout! ' . l:bufnr
    endif
  endfor

  botright split | resize 15
  call term_start(l:cmd, {'curwin': 1, 'term_name': 'Output:D'})
  " call win_gotoid(l:curr_win) move the cursor to this buffer
endfunction

nnoremap <silent> <leader>\ :call Runcode()<cr>
" End CodeRunner+++


