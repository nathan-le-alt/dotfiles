" Load Plugins Configurations ---

" Vim configuration for Git edit & Detect the correct config folder
if has("win32") || has("win64")
  let folder = 'vimfiles'
else
  let folder = '.vim'
endif

let s:config_dir = expand('~/' . folder . '/vim-config')

let s:config_files = [
  \ 'vim-airline-config.vim',
  \ 'gitgutter.vim',
  \ 'indentLine-config.vim',
  \ 'coc-config.vim',
  \ 'coc-snippet.vim',
  \ 'coc-diagnostics.vim',
  \ 'coc-format.vim',
  \ 'nerdtree.vim',
  \ 'coc-extensions.vim',
  \ ]

for s:file in s:config_files
  let s:path = s:config_dir . '/' . s:file
  if filereadable(s:path)
    execute 'source' fnameescape(s:path)
  endif
endfor
" End Load Plugins Configurations +++


