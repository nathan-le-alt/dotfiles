" Keybindings ---

" Select entire file
nnoremap gG ggVG

" Copy to clipboard
nnoremap <leader>y "+y
vnoremap <leader>y "+y

" Stop highlight when pressing enter
nnoremap <silent> <cr> :nohlsearch<cr><cr>

" Cycle between buffers
function! SafeBufSwitch(cmd) abort
  if &buftype ==# 'terminal'
    echo 'switch to the source file first!'
    return
  endif
  execute a:cmd
endfunction

nnoremap <silent><s-h> :call SafeBufSwitch('bprevious')<cr>
nnoremap <silent><s-l> :call SafeBufSwitch('bnext')<cr>

" Cycle between windows
nnoremap <silent><c-h> <c-w>h
nnoremap <silent><c-j> <c-w>j
nnoremap <silent><c-k> <c-w>k
nnoremap <silent><c-l> <c-w>l

" Resizing windows
nnoremap <silent><c-up> :resize +2<cr>
nnoremap <silent><c-down> :resize -2<cr>
nnoremap <silent><c-left> :vertical resize -2<cr>
nnoremap <silent><c-right> :vertical resize +2<cr>

" Scrolling documentation (CoC floating windows)
nnoremap <silent><nowait><expr> <c-f> coc#float#has_scroll() ? coc#float#scroll(1) : "\<c-f>"
nnoremap <silent><nowait><expr> <c-b> coc#float#has_scroll() ? coc#float#scroll(0) : "\<c-b>"
inoremap <silent><nowait><expr> <c-f> coc#float#has_scroll() ? "\<c-r>=coc#float#scroll(1)\<cr>" : "\<right>"
inoremap <silent><nowait><expr> <c-b> coc#float#has_scroll() ? "\<c-r>=coc#float#scroll(0)\<cr>" : "\<left>"
vnoremap <silent><nowait><expr> <c-f> coc#float#has_scroll() ? coc#float#scroll(1) : "\<c-f>"
vnoremap <silent><nowait><expr> <c-b> coc#float#has_scroll() ? coc#float#scroll(0) : "\<c-b>"

nnoremap <silent><nowait><expr> <c-d> coc#float#has_scroll() ? coc#float#scroll(1, 1) : "\<c-d>"
nnoremap <silent><nowait><expr> <c-u> coc#float#has_scroll() ? coc#float#scroll(0, 1) : "\<c-u>"
inoremap <silent><nowait><expr> <c-d> coc#float#has_scroll() ? "\<c-r>=coc#float#scroll(1, 1)\<cr>" : "\<c-d>"
inoremap <silent><nowait><expr> <c-u> coc#float#has_scroll() ? "\<c-r>=coc#float#scroll(0, 1)\<cr>" : "\<c-u>"
vnoremap <silent><nowait><expr> <c-d> coc#float#has_scroll() ? coc#float#scroll(1, 1) : "\<c-d>"
vnoremap <silent><nowait><expr> <c-u> coc#float#has_scroll() ? coc#float#scroll(0, 1) : "\<c-u>"

" Close a buffer
nnoremap <silent><leader>w :bd<cr>

" Splitting buffers
nnoremap sh :split<cr>
nnoremap sv :vsplit<cr>
nnoremap sc :close<cr>
nnoremap so :only<cr>

" Remap delete to black hole register (delete without yanking)
nnoremap d "_d
nnoremap c "_c
nnoremap x "_x
vnoremap d "_d
vnoremap c "_c
vnoremap x "_x

" Cutting (yank to default register)
nnoremap <leader>d d
vnoremap <leader>d d
nnoremap <leader>dd dd

" Pasting (paste over selection without overwriting register)
xnoremap p P
" End Keybindings +++


" CodeRunner ---
function! Runcode() abort
  if &buftype ==# 'terminal'
    echo '[code runner] Switch to the source file first!'
    return
  endif
  write
  let l:filetype = &filetype
  let l:curr_win = win_getid()
  let l:file = expand('%:p')
  let l:output = expand('%:p:r')

  if l:filetype ==# 'python'
    let l:venv_dir = getcwd() . '/.venv'
    let l:venv_python = has('win32') || has('win64')
          \ ? l:venv_dir . '/Scripts/python.exe'
          \ : l:venv_dir . '/bin/python'
    let l:fallback = has('win32') || has('win64') ? 'python' : 'python3'

    if isdirectory(getcwd() . '/.venv')
          \ && !empty($VIRTUAL_ENV)
          \ && fnamemodify($VIRTUAL_ENV, ':p') ==? fnamemodify(l:venv_dir, ':p')
      let l:cmd = [l:venv_python, l:file]
    else
      let l:cmd = [l:fallback, l:file]
    endif
  elseif l:filetype ==# 'c'
    if has('win32') || has('win64')
      let l:vcvars = '"C:\Program Files (x86)\Microsoft Visual Studio\18\BuildTools\VC\Auxiliary\Build\vcvars64.bat"'
      let l:cmd = 'cmd.exe /c "' . l:vcvars . ' >nul && clang "' . l:file . '" -o "' . l:output . '.exe" && "' . l:output . '.exe"'
    else
      let l:cmd = ['sh', '-c', 'clang "$1" -o "$2" && "$2"', 'sh', l:file, l:output] "replace bash with sh
    endif
  elseif l:filetype ==# 'javascript'
    let l:cmd = ['node', l:file]
  elseif l:filetype ==# 'java'
    let l:cmd = ['java', l:file]
  else
    echo '[code runner] No run command set for filetype: ' . l:filetype
    return
  endif

  for l:bufnr in range(1, bufnr('$'))
    if bufexists(l:bufnr) && getbufvar(l:bufnr, '&buftype') ==# 'terminal'
      execute 'bwipeout! ' . l:bufnr
    endif
  endfor

  botright split | resize 15
  call term_start(l:cmd, {'curwin': 1, 'term_name': 'Output:D'})
  " call win_gotoid(l:curr_win) move the cursor to this buffer
endfunction

nnoremap <silent> <leader>\ :call Runcode()<cr>
" End CodeRunner+++


